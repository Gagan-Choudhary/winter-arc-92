NEXT_PUBLIC_SITE_URL=https://winterarctracker.vercel.app
SITE_URL=https://winterarctracker.vercel.app

# Use Test Mode keys in preview, Live Mode keys in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CALLBACK_URL=https://winterarctracker.vercel.app/success

# Connect the private Blob store to this Vercel project. Vercel supplies
# BLOB_STORE_ID and VERCEL_OIDC_TOKEN automatically in deployed Functions.
# For local development, pull the Development environment with `vercel env pull`.
PRODUCT_BLOB_PATH=products/Winter_Arc_92_Product.zip

# Generate three different 32-byte random hex secrets.
ENTITLEMENT_HASH_SECRET=
ACCESS_TOKEN_SECRET=
DOWNLOAD_SIGNING_SECRET=

# Resend is required for new checkout verification and returning-buyer recovery.
RESEND_API_KEY=
DOWNLOAD_FROM_EMAIL=
